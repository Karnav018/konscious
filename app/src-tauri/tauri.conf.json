{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Konscious",
  "version": "0.3.2",
  "identifier": "dev.karnav.konscious",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Konscious",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 640,
        "visible": false,
        "backgroundColor": "#212121",
        "backgroundThrottling": "disabled",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 23
        },
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Karnav018/konscious/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0M0E5N0JFRTc3MkM5RTIKUldUaXlYTG52cGM2bEtJQXpUblZNMGxETEFZUXZRRGRwbTg2aUFQemVOaU92ZDhXRnZkS2laVG8K",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Every Claude session, one calm place.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": [
          "kon"
        ],
        "name": "Konscious workspace",
        "description": "A Konscious workspace and its conversations",
        "role": "Editor"
      }
    ]
  },
  "mainBinaryName": "Konscious"
}
