<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The Music app reads what is playing by sending Apple events to Spotify
       and Music (src-tauri/src/media.rs). Under the hardened runtime that is
       refused outright without this entitlement, and refused silently — so it
       is declared now rather than on the day someone first notarizes a build
       and spends an afternoon wondering why Now Playing stopped working.
       With the current ad-hoc signature it has no effect either way. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
