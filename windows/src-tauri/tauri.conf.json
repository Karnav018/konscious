{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Konscious",
  "version": "0.2.0",
  "identifier": "dev.karnav.konscious",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Konscious",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 640,
        "visible": false,
        "backgroundColor": "#212121",
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Karnav018/konscious/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3ODI4ODc0RkU1NEU2NTAKUldSUTVsVCtkSWlDeDhBYnI0WUVGMkFRcDcyeGd0dHZ4RHN2anVJOFE5VUtZN0gwK0xWMWZqSmQK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Every Claude session, one calm place.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "mainBinaryName": "Konscious"
}
