{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kova",
  "version": "0.1.0",
  "identifier": "dev.karnav.kova",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kova",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 640,
        "visible": false,
        "backgroundColor": "#212121",
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Every Claude session, one calm place.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "mainBinaryName": "Kova"
}
